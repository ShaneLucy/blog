{
	"name": "blog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --write . && eslint . && bun run lint:css && bun run check",
		"lint:css": "stylelint \"src/**/*.css\" \"src/**/*.svelte\" --fix",
		"format": "prettier --write .",
		"test:unit": "vitest run --run",
		"coverage": "vitest run --run --coverage",
		"process-images": "bun run scripts/process-images.ts",
		"test:e2e": "playwright install && playwright test",
		"test": "bun run test:unit && bun run test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.8",
		"bun-types": "^1.3.14",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"stylelint": "^17.12.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"sharp": "^0.34.5"
	}
}
